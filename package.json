{
  "name": "@zpcscc/configs",
  "version": "3.0.7",
  "description": "项目通用配置",
  "keywords": [
    "commitlint",
    "eslint",
    "prettier",
    "tsconfig",
    "types",
    "react",
    "configs"
  ],
  "homepage": "https://zpcscc.github.io/configs",
  "repository": "https://github.com/zpcscc/configs",
  "license": "MIT",
  "author": {
    "name": "zpcscc",
    "email": "dxsixpc@gmail.com"
  },
  "files": [
    "dist",
    "commitlint-config",
    "eslint-config",
    "prettier-config",
    "tsconfig",
    "types"
  ],
  "scripts": {
    "build": "father build && mkdir -p dist/tsconfig && cp src/tsconfig/tsconfig.json dist/tsconfig/ && rm -rf dist/eslint-config && cp -r src/eslint-config dist/eslint-config",
    "build:watch": "father dev",
    "commit": "git add . && git-cz",
    "deploy": "pnpm run docs:build && pnpm run docs:deploy",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:deploy": "gh-pages -d docs-dist",
    "prepublishOnly": "pnpm run build && cp -r ./dist/* . && rm -rf dist",
    "postpublish": "git clean -fd",
    "start": "dumi dev"
  },
  "dependencies": {
    "@babel/core": "7.26.10",
    "@babel/plugin-syntax-flow": "7.26.0",
    "@babel/plugin-transform-react-jsx": "7.25.9",
    "@babel/runtime": "7.26.10",
    "@commitlint/cz-commitlint": "20.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.11",
    "@types/react-dom": "19.0.4",
    "commitizen": "4.3.1",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.2.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unicorn": "59.0.1",
    "globals": "17.4.0",
    "inquirer": "9.3.8",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "4.1.0",
    "prettier-plugin-packagejson": "2.5.10",
    "typescript": "5.8.2",
    "typescript-eslint": "8.57.2"
  },
  "devDependencies": {
    "dumi": "2.4.18",
    "father": "4.5.2",
    "gh-pages": "6.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "styled-components": "6.1.16",
    "tslib": "2.8.1",
    "webpack": "5.98.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
